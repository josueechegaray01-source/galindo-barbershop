{
  "version": 2,
  "builds": [
    {
      "src": "build/web/**",
      "use": "@vercel/static",
      "config": {
        "cleanUrls": false,
        "rewrites": [
          { "source": "/(.*)", "destination": "/index.html" }
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}